{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dao-vo-tan:gate1:vfx-parameters:v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "variantId": {
      "type": "string",
      "minLength": 1
    },
    "template": {
      "enum": [
        "Charge",
        "Trail",
        "Projectile",
        "Impact",
        "Aura",
        "GroundField"
      ]
    },
    "color": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 4,
      "maxItems": 4
    },
    "intensity": {
      "type": "number",
      "minimum": 0,
      "maximum": 4
    },
    "scale": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 10
    },
    "durationSeconds": {
      "type": "number",
      "minimum": 0.05,
      "maximum": 120
    },
    "theme": {
      "type": "string",
      "minLength": 1
    },
    "socket": {
      "enum": [
        "weapon_hand",
        "weapon_sheath",
        "headwear",
        "back_accessory",
        "aura_root",
        "feet",
        "portrait_focus"
      ]
    },
    "realmPresentationLevel": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    }
  },
  "required": [
    "schemaVersion",
    "variantId",
    "template",
    "color",
    "intensity",
    "scale",
    "durationSeconds",
    "theme",
    "socket",
    "realmPresentationLevel"
  ]
}