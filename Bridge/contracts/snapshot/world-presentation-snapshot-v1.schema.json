{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dao-vo-tan:presentation-snapshot:1",
  "title": "WorldPresentationSnapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "worldId",
    "rulesetVersion",
    "simulationVersion",
    "streamId",
    "sequence",
    "worldTick",
    "throughEventId",
    "controlledActorId",
    "actors",
    "actions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "worldId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "maxLength": 512
    },
    "rulesetVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "simulationVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "streamId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "worldTick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "throughEventId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:event:[0-9]{8,}$",
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "controlledActorId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:agent:[0-9]{8,}$",
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "actors": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actorId",
          "displayName",
          "location",
          "behaviorStatus",
          "lifeStatus",
          "cultivation",
          "appearanceSeed",
          "currentAction"
        ],
        "properties": {
          "actorId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:agent:[0-9]{8,}$",
            "maxLength": 512
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "regionId"
            ],
            "properties": {
              "regionId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*:region:[0-9]{8,}$",
                "maxLength": 512
              }
            }
          },
          "behaviorStatus": {
            "enum": [
              "active",
              "inactive"
            ]
          },
          "lifeStatus": {
            "enum": [
              "alive",
              "dead",
              "unknown"
            ]
          },
          "cultivation": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "hasMethod",
                  "completedSessions"
                ],
                "properties": {
                  "hasMethod": {
                    "type": "boolean"
                  },
                  "completedSessions": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "appearanceSeed": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "currentAction": {
            "type": "null"
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actorId",
          "actionInstanceId",
          "actionType",
          "phase",
          "occurredAtTick"
        ],
        "properties": {
          "actorId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:agent:[0-9]{8,}$",
            "maxLength": 512
          },
          "actionInstanceId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:event:[0-9]{8,}$",
            "maxLength": 512
          },
          "actionType": {
            "const": "cultivation_session_completed"
          },
          "phase": {
            "const": "completed"
          },
          "occurredAtTick": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    }
  },
  "$comment": "Runtime validators additionally enforce safe positive ID sequences, matching world/kind, unique ordinal actor order, controlled actor membership, action actor membership/uniqueness and nondecreasing action ticks <= worldTick. Adapter limits rendered selection to 3."
}
